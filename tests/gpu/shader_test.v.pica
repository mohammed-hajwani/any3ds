; Exercises the vertex shader interpreter (tests/gpu/test_gpu.c checks
; every output against values worked out by hand). Assembled with
; devkitPro's picasso, so the instruction encodings are the real ones.
;
; Inputs: v0 = (1, 2, 3, 4), v1 = (0.5, -1, 2, 8), v2 = (10, 20, 30, 40),
;         v3 = (2, 1, 0, 0). Uniforms: b0 = true, b1 = false.

.constf k(2.0, 0.5, -1.0, 0.25)
.constf ones(1.0, 1.0, 1.0, 1.0)
.constf zero(0.0, 0.0, 0.0, 0.0)
.constfa tab[]                      ; an array: consecutive c registers
.constfa (100.0, 101.0, 102.0, 103.0)
.constfa (110.0, 111.0, 112.0, 113.0)
.constfa (120.0, 121.0, 122.0, 123.0)
.constfa (130.0, 131.0, 132.0, 133.0)
.end
.constf misc(2.75, -2.25, 16.0, 3.0)
.consti loop3(2, 1, 2, 0)          ; 3 iterations, aL = 1, 3, 5
.setb b0 true
.setb b1 false

.out o0 dummy
.out o1 dummy
.out o2 dummy
.out o3 dummy
.out o4 dummy
.out o5 dummy
.out o6 dummy
.out o7 dummy
.out o8 dummy
.out o9 dummy
.out o10 dummy

.proc main
    ; (An instruction can read only one input register, so copy v1-v3 first.)
    mov r10, v1
    mov r11, v2
    mov r12, v3
    add o0, v0, r10                 ; (1.5, 1, 5, 12)
    mul o1, k, v0                   ; (2, 1, -3, 1)

    dp3 r0.x, v0, r10                ; 0.5 - 2 + 6 = 4.5
    dp4 r0.y, v0, r10                ; 4.5 + 32 = 36.5
    dph r0.z, v0, r10                ; 4.5 + 8 = 12.5
    rcp r0.w, r10.x                  ; 2
    mov o2, r0

    mad o3, v0, r10, r11              ; (10.5, 18, 36, 72)
    mov o4, -v0.wzyx                ; (-4, -3, -2, -1)

    mov r1, zero
    max r1.xy, v0, r10               ; (1, 2, _, _)
    min r1.zw, v0, r10               ; (_, _, 2, 4)
    mov o5, r1

    mova a0.x, r12.x                 ; a0.x = 2
    mov o6, tab[a0.x]               ; tab[2] = (120, 121, 122, 123)

    mov r2, zero
    cmp v0, gt, lt, r10              ; cmp.x: 1 > 0.5 true; cmp.y: 2 < -1 false
    ifc cmp.x
        mov r2.x, k.x               ; taken: 2
    .else
        mov r2.x, k.z
    .end
    ifc cmp.y
        mov r2.y, k.x
    .else
        mov r2.y, k.z               ; not taken: -1
    .end
    mov r3, zero
    for loop3                       ; aL = 1, 3, 5
        add r3.x, ones.x, r3.x      ; counts iterations: 3
    .end
    mov r2.z, r3.x
    call set_w                      ; r2.w = 7 (b0 true)
    mov o7, r2                      ; (2, -1, 3, 7)

    flr r4.x, misc.x                ; 2
    flr r4.y, misc.y                ; -3
    rsq r4.z, misc.z                ; 0.25
    sge r4.w, v0.x, ones.x          ; 1 >= 1: 1
    mov o8, r4

    ex2 r5.x, misc.w                ; 8
    lg2 r5.y, misc.z                ; 4
    slt r5.z, v0.x, ones.x          ; 1 < 1: 0
    mov r5.w, -zero.x               ; -0 -> 0 (no negative zero)
    mov o9, r5

    mov r6, zero
    for loop3
        add r6.x, misc.w, r6.x      ; sums 3 three times: 9
        breakc cmp.x                ; cmp.x is still true: leaves after the first pass
    .end
    mov r6.y, ones.x
    mov o10, r6                     ; (3, 1, 0, 0)
    end
.end

.proc set_w
    ifu b0
        mov r2.w, misc.w            ; 3
        add r2.w, k.y, r2.w         ; 3.5
        add r2.w, r2.w, r2.w        ; 7
    .else
        mov r2.w, zero.x
    .end
.end
